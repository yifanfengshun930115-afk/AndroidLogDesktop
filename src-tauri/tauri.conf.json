{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Android Log Desktop",
  "version": "0.1.7",
  "identifier": "com.gzq.androidlog.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer:if-stale"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Android Log Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "../resources/platform-tools": "platform-tools"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
